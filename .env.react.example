# React Deployment Configuration
# Copy this file to .env.react and update with your actual values

# Required: GitHub repository URL for your Next.js application
REACT_REPO_URL=git@github.com:your-org/your-react-app.git

# Optional: Branch to deploy (default: main)
REACT_BRANCH=main

# Optional: Build directory name (default: build)
REACT_BUILD_DIR=build

# Optional: Public directory (default: public)
REACT_PUBLIC_DIR=public 