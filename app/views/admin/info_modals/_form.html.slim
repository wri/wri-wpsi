.mb-4 = form_for [:admin, @info_modal] do |f|
  = render 'admin/shared/error_messages', resource: @info_modal

  .form-group
    .field
      = f.label :info_modal_id
      = f.text_field :info_modal_id, class: 'form-control'
  .form-group
    .field
      = f.label :title
      = f.text_field :title, class: 'form-control'
  .form-group
    .field
      = f.label :content
      = f.text_area :content, rows: 8, class: 'form-control'
  .actions = f.submit class: 'btn btn-primary' 